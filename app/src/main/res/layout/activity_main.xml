<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F3E9">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HyperDeX" android:textSize="36sp" android:fontFamily="serif" android:textColor="#262820" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CAC8BC" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="@integer/settings_orientation">
      <LinearLayout android:layout_width="@dimen/settings_intro_width" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="20dp" android:paddingTop="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Desktop mode" android:textSize="15sp" android:textColor="#53614C" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="30sp" android:id="@+id/tv_mode_title" android:textColor="#263925" android:fontFamily="serif" android:layout_marginTop="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:id="@+id/tv_mode_desc" android:textColor="#4E5449" android:layout_marginTop="6dp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switch_main_mode" android:text="Use Classic DeX" android:minHeight="56dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingTop="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Desktop controls" android:textSize="24sp" android:fontFamily="serif" android:textColor="#283927" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CAC8BC" />
        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switch_start_menu" android:text="App grid" android:textSize="16sp" android:minHeight="48dp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switch_search_button" android:text="App search" android:textSize="16sp" android:minHeight="48dp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switch_nav_buttons" android:text="Back, Home and Recents" android:textSize="16sp" android:minHeight="48dp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switch_window_controls" android:text="Window title buttons" android:textSize="16sp" android:minHeight="48dp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switch_floating_popups" android:text="Floating tray panels" android:textSize="16sp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Taskbar fit" android:textSize="24sp" android:fontFamily="serif" android:textColor="#283927" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CAC8BC" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Bar height" android:textSize="16sp" android:layout_weight="1" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:id="@+id/tv_taskbar_height_val" android:fontFamily="monospace" />
        </LinearLayout>
        <SeekBar android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/seek_taskbar_height" android:contentDescription="Bar height" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Icon size" android:textSize="16sp" android:layout_weight="1" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:id="@+id/tv_icon_size_val" android:fontFamily="monospace" />
        </LinearLayout>
        <SeekBar android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/seek_icon_size" android:contentDescription="Icon size" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Icon spacing" android:textSize="16sp" android:layout_weight="1" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:id="@+id/tv_icon_spacing_val" android:fontFamily="monospace" />
        </LinearLayout>
        <SeekBar android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/seek_icon_spacing" android:contentDescription="Icon spacing" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Opacity" android:textSize="16sp" android:layout_weight="1" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:id="@+id/tv_taskbar_opacity_val" android:fontFamily="monospace" />
        </LinearLayout>
        <SeekBar android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/seek_taskbar_opacity" android:contentDescription="Opacity" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Bottom offset" android:textSize="16sp" android:layout_weight="1" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:id="@+id/tv_taskbar_offset_val" android:fontFamily="monospace" />
        </LinearLayout>
        <SeekBar android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/seek_taskbar_offset" android:contentDescription="Bottom offset" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btn_reset_defaults" android:text="Reset taskbar sizing" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btn_restart" android:text="Restart Launcher and System UI" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:id="@+id/tv_footer_credit" android:textColor="#51584E" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</ScrollView>
